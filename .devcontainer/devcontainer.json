{
  "name": "TeeTIM - PHP 8.3 + MySQL 8 + phpMyAdmin",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": { "label": "Site TeeTIM", "onAutoForward": "openBrowser" },
    "8081": { "label": "phpMyAdmin", "onAutoForward": "notify" }
  },
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "cweijan.vscode-mysql-client2"
      ]
    }
  }
}
